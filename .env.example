# ─── Accord CRM — Environment Variables ──────────────────────────────────────
#
# Copy this file to .env.local and fill in your real values.
# Never commit .env.local to version control.
#
# Vite exposes variables prefixed with VITE_ to the browser bundle.
# Server-only secrets (e.g. service-role key) should never use VITE_ prefix.
#
# ─── Supabase ─────────────────────────────────────────────────────────────────
#
# Find these in your Supabase project settings → API
#
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
#
# Optional: service-role key for server-side operations (never expose to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
#
# ─── App ──────────────────────────────────────────────────────────────────────
#
# Set to "true" to use real Supabase backend, "false" to use mock data
# Defaults to "false" so the app works out-of-the-box without a Supabase project
VITE_USE_REAL_BACKEND=false
#
# App base URL (used in email templates, password reset links, etc.)
VITE_APP_URL=http://localhost:5173
#
# ─── Feature flags (optional) ─────────────────────────────────────────────────
#
# VITE_ENABLE_ANALYTICS=true
# VITE_ENABLE_REALTIME=false

# ─── External Mail & Calendar integrations ────────────────────────────────────
#
# ⚠️  NONE of these may ever be given a VITE_ prefix.
#
# Vite compiles every VITE_* variable into the browser bundle. An OAuth client
# secret placed there would be published to every visitor. These values belong
# ONLY in Supabase Edge Function secrets:
#
#     supabase secrets set GOOGLE_CLIENT_ID=... GOOGLE_CLIENT_SECRET=...
#
# They are listed here purely as documentation of what must be configured.
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are injected
# into Edge Functions automatically by Supabase — do not set them yourself.
#
# Redirect URI to register with ALL THREE providers (identical for each):
#   https://<project-ref>.supabase.co/functions/v1/oauth-callback
#
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# Scopes: gmail.send (send only — NOT gmail.readonly), calendar.events
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
#
# Microsoft Entra ID → App registrations (multi-tenant / "common" endpoint)
# Delegated permissions: Mail.Send, Calendars.ReadWrite, offline_access, User.Read
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
#
# Zoho API Console → Server-based Applications
# Scopes: ZohoMail.messages.CREATE, ZohoMail.accounts.READ, ZohoCalendar.event.ALL
#   ZohoMail.messages.CREATE = send only (NOT .READ / .UPDATE / .ALL)
#   ZohoMail.accounts.READ   = account identity ONLY (accountId, mailbox address).
#                              Zoho keeps account info and message content in
#                              separate scope namespaces, so this grants NO
#                              inbox access. It is required because Zoho's send
#                              endpoint is POST /api/accounts/{accountId}/messages
#                              and accountId comes only from the accounts API.
# ZOHO_ACCOUNTS_HOST is only the STARTING data centre; each user's actual DC is
# detected at callback time and persisted per account, so non-US users work too.
# ZOHO_CLIENT_ID=
# ZOHO_CLIENT_SECRET=
# ZOHO_ACCOUNTS_HOST=https://accounts.zoho.com
#
# Edge Function secrets — which origins the integration functions serve.
#
# APP_URL          Primary origin. The post-OAuth redirect and the CORS
#                  allow-list both fall back to this.
# APP_URL_ALLOWED  Optional, comma-separated ADDITIONAL origins. This is what
#                  lets ONE Supabase project serve local development and the
#                  deployed app at the same time — without it, whichever origin
#                  APP_URL names is the only one the OAuth return trip works on.
#
# Origins are matched exactly (scheme + host + port) against this server-side
# list. An origin that is not listed falls back to APP_URL, so this can never
# become an open redirect.
#
# Local development only:
#   APP_URL=http://localhost:5173
#
# Production + local development from the same project:
#   APP_URL=https://your-app.vercel.app
#   APP_URL_ALLOWED=http://localhost:5173
#
# Set them with:
#   npx supabase secrets set APP_URL=... APP_URL_ALLOWED=...
#
# NOTE: the provider redirect URI does NOT change between environments — it is
# always https://<project-ref>.supabase.co/functions/v1/oauth-callback, so you
# register it once per provider regardless of how many origins you allow.
