# ─── Dependencies ─────────────────────────────────────────────────────────────
node_modules

# ─── Build output ─────────────────────────────────────────────────────────────
dist
dist-ssr
*.local

# ─── Environment files ────────────────────────────────────────────────────────
#
# NOTE: the previous version of this file had `.env.env.local` on a single line
# — two entries collapsed into one. Neither `.env` nor `.env.local` was ignored
# as a result, since `.env.*.local` does NOT match `.env.local`.
#
# `.env.example` is deliberately NOT ignored: it documents required variables
# using placeholder values only.
.env
.env.*
!.env.example

# ─── Supabase CLI local state ─────────────────────────────────────────────────
# Holds the linked project ref and other machine-local metadata.
supabase/.temp
supabase/.branches

# ─── Deployment ───────────────────────────────────────────────────────────────
.vercel

# ─── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
